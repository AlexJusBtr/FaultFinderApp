<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pink"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FaultFinder"
                android:textColor="@color/green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/green" />
        </LinearLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:hint="Search area or fault..."
            android:inputType="text"
            android:paddingStart="8dp"
            android:textSize="13sp" />

        <!-- Map View Card (Clean Border & Balanced 210dp Viewport) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1.5dp">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Categories Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="Categories"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Single Line Categories -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roadsBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🚧 Roads"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/waterBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="💧 Water"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/electricityBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="⚡ Electricity"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/lightsBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="💡 Streetlights"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wasteBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🗑️ Waste"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/otherBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="❓ Other"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Recent Reports Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:text="Recent reports near you"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Recent Reports List (clipToPadding allows items to scroll above the floating FAB) -->
        <ListView
            android:id="@+id/listRecentReports"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:paddingBottom="84dp" />
    </LinearLayout>

    <!-- Speed Dial Buttons (Floating circular mini action items) -->

    <!-- Diagonally Up-Left: Map -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:contentDescription="Map"
        android:src="@android:drawable/ic_dialog_map"
        android:visibility="invisible"
        app:backgroundTint="@color/green"
        app:elevation="8dp"
        app:fabSize="mini"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="#FFFFFF" />

    <!-- Top: New Report -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:contentDescription="New Report"
        android:src="@android:drawable/ic_menu_edit"
        android:visibility="invisible"
        app:backgroundTint="@color/green"
        app:elevation="8dp"
        app:fabSize="mini"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="#FFFFFF" />

    <!-- Diagonally Up-Right: Settings -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:contentDescription="Settings"
        android:src="@android:drawable/ic_menu_preferences"
        android:visibility="invisible"
        app:backgroundTint="@color/green"
        app:elevation="8dp"
        app:fabSize="mini"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="#FFFFFF" />

    <!-- Center Floating Action Button (Solid Circle floating above ListView) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:contentDescription="Actions"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/green"
        app:elevation="10dp"
        app:fabSize="normal"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="#FFFFFF" />

</FrameLayout>