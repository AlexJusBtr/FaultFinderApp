<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Universal Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/pink"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/green" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:letterSpacing="-0.02"
                android:text="Fault Map"
                android:textColor="@color/green"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="User Profile"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/green" />
        </LinearLayout>

        <!-- Horizontal Filter Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:clipToPadding="false"
            android:elevation="2dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_btn_green"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filterRoads"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🚧 Roads"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filterWater"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="💧 Water"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filterElectricity"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="⚡ Electricity"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filterLights"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="💡 Streetlights"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filterWaste"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🗑️ Waste"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Full Interactive Map View -->
        <org.osmdroid.views.MapView
            android:id="@+id/fullMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Map Floating Overlays -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMapRecenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="110dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Recenter"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="#FFFFFF"
        app:elevation="4dp"
        app:fabSize="mini"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/green" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnQuickReportHere"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="Report Fault"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/green"
        app:elevation="6dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="#FFFFFF" />

</FrameLayout>